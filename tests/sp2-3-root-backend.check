# SP2 step 3: the pipeline configuration points at the same bucket, under its
# own key.
# Format: file | regular expression the file must contain | message if it doesn't
terraform/backend.tf | ^  backend "s3" \{ | the root config needs the backend
terraform/backend.tf | ^    key          += "serverless-pipeline/terraform\.tfstate"$ | the pipeline's own key, which keeps the two stacks apart
terraform/backend.tf | ^    use_lockfile += true$ | native locking here too
